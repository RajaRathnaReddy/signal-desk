{
  "name": "signal-desk",
  "version": "1.0.0",
  "private": true,
  "description": "Signal Desk — an independent technology newsroom platform with a verification-first editorial workflow.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup": "prisma db push && tsx prisma/seed.ts",
    "db:postgres": "node scripts/use-postgres.mjs",
    "ingest": "tsx scripts/ingest.ts",
    "audit:security": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.2",
    "fast-xml-parser": "^5.2.5",
    "jose": "^6.1.0",
    "marked": "^16.4.0",
    "next": "^15.5.0",
    "nodemailer": "^10.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sanitize-html": "^2.17.0",
    "server-only": "^0.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.0",
    "prisma": "^6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
