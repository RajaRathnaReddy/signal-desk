DATABASE_URL="file:./dev.db"

# Public site URL (used for canonical URLs, sitemap, RSS, Open Graph)
SITE_URL="http://localhost:3000"

# Random 32+ char secret used to hash visitor identifiers and sign tokens.
APP_SECRET="change-me-to-a-long-random-string-0123456789"

# Initial administrator, created by `npm run db:seed` if no admin exists.
# If ADMIN_PASSWORD is empty a random one is generated and printed once.
ADMIN_EMAIL="editor@example.com"
ADMIN_PASSWORD=""

# Secret for the scheduled ingestion endpoint: POST /api/cron/ingest  (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""

# Optional. Without a key, AI-assisted drafting is disabled (manual writing still works).
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Optional SMTP. Without it, newsletter confirmation emails are not sent and the UI says so.
SMTP_URL=""
MAIL_FROM="Signal Desk <newsletter@example.com>"
